GIN_MODE=debug #change it to release if its for production

PORT=8000 #change the port to port that available
COOKIE_DOMAIN=localhost
ALLOWED_ORIGINS=http://127.0.0.1:3000 #Dont forget to change the origin so it can work (more than 1 is allowed)

MONGODB_URI=mongodb+srv://


JWT_SECRET=YOUR-JWT-SECRET #change the secret to 32char or 64char
JWT_EXPIRES=enable
JWT_EXPIRES_IN=24

GOOGLE_CLIENT_ID=.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=add-the-secret-from-google
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

OAUTH_FRONTEND_URL=http://127.0.0.1:3000/auth
SUCCESS_FRONTEND_URL=http://127.0.0.1:3000/dashboard
SESSION_SECRET=aVeryLongAndSecretRandomString1234567890

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=